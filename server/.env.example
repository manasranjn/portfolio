# Server
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MongoDB (used to store a copy of every contact submission)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Email (SMTP) - the account that SENDS the notification
# For Gmail: enable 2FA then create an "App Password" and use it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password

# Where contact form messages should be delivered
CONTACT_RECEIVER_EMAIL=your.email@gmail.com
